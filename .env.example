# ========================================================
# RightWISE - Environment Variables Configuration
# ========================================================
# 1. Lấy API Key miễn phí (0đ) tại: https://aistudio.google.com/
# 2. Trên Vercel: Vào Project Settings -> Environment Variables
#    Thêm Key: GEMINI_API_KEY, Value: <khóa API của bạn>
# ========================================================

GEMINI_API_KEY=your_gemini_api_key_here
PORT=8000
HOST=0.0.0.0
