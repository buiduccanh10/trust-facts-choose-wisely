# Next.js frontend: public API URL, never place provider credentials here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# NestJS API server-only configuration.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=minimax/minimax-m3.1-flash
# Google Search grounding for product lookup; separate from the AI Gateway key.
GEMINI_API_KEY=
GOOGLE_SEARCH_MODEL=gemini-3.5-flash-lite
# Search fallback runs only when Google returns HTTP 429. Tako Search is billed per request.
TAKO_SEARCH_FALLBACK_ENABLED=true
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
WEB_ORIGIN=http://localhost:3001
