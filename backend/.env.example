# RightWISE Backend Environment Variables

# Lấy Gemini API Key hoàn toàn MIỄN PHÍ tại Google AI Studio:
# https://aistudio.google.com/ (Đăng nhập Gmail -> Bấm "Create API Key" - Mất 30 giây)
# Hạn mức miễn phí: 15 lượt gọi / phút, 1.500 lượt / ngày.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Cổng khởi chạy server (mặc định 8000)
PORT=8000
HOST=0.0.0.0
