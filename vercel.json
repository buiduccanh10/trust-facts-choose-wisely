{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path__=/api/$1"
    },
    {
      "source": "/health",
      "destination": "/api/index.py?__path__=/health"
    },
    {
      "source": "/verify",
      "destination": "/api/index.py?__path__=/verify"
    },
    {
      "source": "/verify-url",
      "destination": "/api/index.py?__path__=/verify-url"
    }
  ]
}
